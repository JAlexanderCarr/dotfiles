#!/bin/bash
# Installs motd via the OS's native login mechanism:
# - Linux with update-motd.d: symlinks the dynamic motd script
# - macOS / Linux without update-motd.d: generates a static /etc/motd file

# Initialize log file first (before any redirects)
mkdir -p "${HOME}/.local/log/chezmoi"
CHEZMOI_LOG_FILE="${HOME}/.local/log/chezmoi/install-$(date +%Y%m%d-%H%M%S).log"

# Source the logging helper
HELPER_SCRIPT="${HOME}/.local/bin/chezmoi-log-helper.sh"
if [[ -f "$HELPER_SCRIPT" ]]; then
    source "$HELPER_SCRIPT"
else
    # Fallback if helper not yet installed - create minimal functions
    print_header() { printf "\n\033[1m\033[34m▸\033[0m \033[1m%s\033[0m\n" "$1"; }
    print_done() { printf "  \033[32m✓\033[0m %s\n" "$1"; }
    print_fail() { printf "  \033[31m✗\033[0m %s\n" "$1"; }
    log_silent() { echo "[$(date '+%H:%M:%S')] $*" >> "$CHEZMOI_LOG_FILE"; }
    log_section() { echo "=== $1 ===" >> "$CHEZMOI_LOG_FILE"; }
fi

{{ if not .addons.motd -}}
exit 0
{{ end -}}

set -euo pipefail

log_section "MOTD Installation"
print_header "MOTD Configuration"

MOTD_DYNAMIC="${HOME}/.local/bin/motd"
MOTD_STATIC="${HOME}/.local/bin/motd-static"

if [[ -d /etc/update-motd.d ]]; then
    # Linux with update-motd.d: install dynamic motd
    log_silent "Detected /etc/update-motd.d, installing dynamic motd"

    MOTD_TARGET="/etc/update-motd.d/99-custom-motd"

    if [[ -f "$MOTD_DYNAMIC" ]]; then
        sudo cp "$MOTD_DYNAMIC" "$MOTD_TARGET" 2>> "$CHEZMOI_LOG_FILE"
        sudo chmod 755 "$MOTD_TARGET" 2>> "$CHEZMOI_LOG_FILE"
        print_done "Installed dynamic motd to $MOTD_TARGET"
    else
        print_fail "Dynamic motd script not found at $MOTD_DYNAMIC"
        log_silent "Missing $MOTD_DYNAMIC"
    fi

    # Remove stale static /etc/motd if present
    if [[ -f /etc/motd ]]; then
        sudo rm -f /etc/motd 2>> "$CHEZMOI_LOG_FILE" || true
        print_done "Removed stale /etc/motd"
        log_silent "Removed stale /etc/motd"
    fi
else
    # macOS or Linux without update-motd.d: generate static /etc/motd
    log_silent "No /etc/update-motd.d found, generating static /etc/motd"

    if [[ -f "$MOTD_STATIC" ]]; then
        local_motd=$("$MOTD_STATIC" 2>/dev/null)
        echo -e "$local_motd" | sudo tee /etc/motd > /dev/null 2>> "$CHEZMOI_LOG_FILE"
        print_done "Generated static /etc/motd from motd-static"
    else
        print_fail "Static motd script not found at $MOTD_STATIC"
        log_silent "Missing $MOTD_STATIC"
    fi
fi

log_silent "MOTD installation complete"
