#!/bin/bash
# chezmoi:template:left-delimiter="{{" right-delimiter="}}"
# Install VSCode user configuration (settings and keybindings)
# Re-runs automatically when source config files change.
# {{ include "vscode/settings.json" | sha256sum }}
# {{ include "vscode/keybindings.json" | sha256sum }}
# {{ include "vscode/extensions.txt" | sha256sum }}

source "${HOME}/.local/bin/chezmoi-log-helper.sh" 2>/dev/null || {
    mkdir -p "${HOME}/.local/log/chezmoi"
    CHEZMOI_LOG_FILE="${HOME}/.local/log/chezmoi/install-$(date +%Y%m%d-%H%M%S).log"
    print_header() { printf "\n\033[1;34m▸\033[0m \033[1m%s\033[0m\n" "$1"; }
    print_done() { printf "  \033[32m✓\033[0m %s\n" "$1"; }
    print_fail() { printf "  \033[31m✗\033[0m %s\n" "$1"; }
    with_spinner() { shift; "$@" >> "$CHEZMOI_LOG_FILE" 2>&1; }
    log_silent() { :; }; log_section() { :; }
}

{{- if not .addons.vscode }}
exit 0
{{- end }}

set -euo pipefail

# Locate the VSCode CLI — checks PATH first, then OS-specific fallback locations
# Returns the path to `code` or exits with 1 if not found
find_code_cli() {
    if command -v code &>/dev/null; then
        command -v code
        return 0
    fi
    # macOS: app bundle binary works even without "Install code in PATH"
    if [[ "$(uname -s)" == "Darwin" ]]; then
        local bundle_code="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
        if [[ -x "$bundle_code" ]]; then
            echo "$bundle_code"
            return 0
        fi
    fi
    # Linux: common install locations
    for candidate in /usr/bin/code /usr/local/bin/code /snap/bin/code /usr/share/code/bin/code; do
        if [[ -x "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Locate vscode source files (same pattern as fonts script)
CHEZMOI_SOURCE="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
VSCODE_SOURCE="$CHEZMOI_SOURCE/vscode"
if [[ ! -d "$VSCODE_SOURCE" ]]; then
    VSCODE_SOURCE="$CHEZMOI_SOURCE/home/vscode"
fi

# Detect OS-specific VSCode settings directory
if [[ "$(uname -s)" == "Darwin" ]]; then
    VSCODE_CONFIG_DIR="$HOME/Library/Application Support/Code/User"
else
    VSCODE_CONFIG_DIR="$HOME/.config/Code/User"
fi

log_section "VSCode Configuration"
print_header "VSCode Configuration"
log_silent "VSCode source: $VSCODE_SOURCE"
log_silent "VSCode config directory: $VSCODE_CONFIG_DIR"

mkdir -p "$VSCODE_CONFIG_DIR" >> "$CHEZMOI_LOG_FILE" 2>&1

# Copy settings.json
if [[ -f "$VSCODE_SOURCE/settings.json" ]]; then
    with_spinner "Installing VSCode settings" \
        cp -f "$VSCODE_SOURCE/settings.json" "$VSCODE_CONFIG_DIR/settings.json"
    print_done "settings.json installed"
    log_silent "Copied settings.json to $VSCODE_CONFIG_DIR"
else
    print_fail "settings.json not found at $VSCODE_SOURCE"
    log_silent "Missing $VSCODE_SOURCE/settings.json"
fi

# Copy keybindings.json
if [[ -f "$VSCODE_SOURCE/keybindings.json" ]]; then
    with_spinner "Installing VSCode keybindings" \
        cp -f "$VSCODE_SOURCE/keybindings.json" "$VSCODE_CONFIG_DIR/keybindings.json"
    print_done "keybindings.json installed"
    log_silent "Copied keybindings.json to $VSCODE_CONFIG_DIR"
else
    print_fail "keybindings.json not found at $VSCODE_SOURCE"
    log_silent "Missing $VSCODE_SOURCE/keybindings.json"
fi

log_silent "VSCode configuration complete"
print_done "VSCode configuration installed"

# Install extensions
EXTENSIONS_FILE="$VSCODE_SOURCE/extensions.txt"
if [[ -f "$EXTENSIONS_FILE" ]]; then
    CODE_CLI="$(find_code_cli 2>/dev/null || true)"
    if [[ -n "$CODE_CLI" ]]; then
        log_section "VSCode Extensions"
        print_header "VSCode Extensions"
        while IFS= read -r ext || [[ -n "$ext" ]]; do
            [[ -z "$ext" || "$ext" == \#* ]] && continue
            with_spinner "Installing $ext" \
                "$CODE_CLI" --install-extension "$ext" --force
            print_done "$ext"
            log_silent "Installed extension: $ext"
        done < "$EXTENSIONS_FILE"
    else
        log_silent "VSCode CLI not found — skipping extension install"
        print_done "Skipped extensions (VSCode CLI not found)"
    fi
fi
