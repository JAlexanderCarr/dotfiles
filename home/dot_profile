# ~/.profile - executed by the command interpreter for login shells
# Not read by bash(1) if ~/.bash_profile or ~/.bash_login exists.

# Add user bin directories to PATH
if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Directory listing colors
export LS_COLORS="${LS_COLORS}:di=04;36:ex=91"

# Kubernetes tools
if [ -d "$HOME/.kubectx" ]; then
    export PATH="$PATH:$HOME/.kubectx"
fi

# NVM (Node Version Manager) - add default node to PATH for login shells
export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR" ] && [ -f "$NVM_DIR/alias/default" ]; then
    _nvm_ver=$(cat "$NVM_DIR/alias/default")
    # Resolve one level of alias indirection (lts/* → lts/jod → v22.x.x)
    [ -f "$NVM_DIR/alias/$_nvm_ver" ] && _nvm_ver=$(cat "$NVM_DIR/alias/$_nvm_ver")
    _nvm_ver="v${_nvm_ver#v}"
    [ -d "$NVM_DIR/versions/node/$_nvm_ver/bin" ] && PATH="$NVM_DIR/versions/node/$_nvm_ver/bin:$PATH"
    unset _nvm_ver
fi

# goenv (Go version manager)
export GOENV_ROOT="$HOME/.goenv"
if [ -d "$GOENV_ROOT" ]; then
    export PATH="$GOENV_ROOT/bin:$GOENV_ROOT/shims:$PATH"
fi

# pyenv (Python version manager)
export PYENV_ROOT="$HOME/.pyenv"
if [ -d "$PYENV_ROOT" ]; then
    export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"
fi

# Obsidian CLI
if [ -d "/Applications/Obsidian.app/Contents/MacOS" ]; then
    export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"
fi

# Source local environment overrides (not managed by chezmoi)
if [ -f "$HOME/.env" ]; then
    . "$HOME/.env"
fi
