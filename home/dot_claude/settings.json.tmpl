{
  "tui": "fullscreen",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000"{{ if eq .addons.claudeProvider "bedrock" }},
    "AWS_PROFILE": "claude-code"{{ end }}
  }
}
