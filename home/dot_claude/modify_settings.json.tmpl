#!/bin/bash
# Merges desired settings into the current settings.json.
# Keys managed by Claude Code (e.g. "model") are preserved rather than overwritten.
set -euo pipefail

desired=$(cat <<'DESIRED'
{
  "tui": "fullscreen",
  "copyOnSelect": false,
  "prStatusFooterEnabled": false,
  "showClearContextOnPlanAccept": true,
  "awaySummaryEnabled": false,
  "autoUpdaterChannel": "stable",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "companyAnnouncements": [
    "󰚩  Roger Roger"
  ],
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "MAX_THINKING_TOKENS": "128000"{{ if eq (index .addons "claudeProvider") "bedrock" }},
    "AWS_PROFILE": "claude-code"{{ end }}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/block-dangerous-rm.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/protect-sensitive-files.sh"
          }
        ]
      }
    ]
  }
}
DESIRED
)

current=$(cat)

if ! command -v jq &>/dev/null; then
  printf '%s\n' "${current:-$desired}"
  exit 0
fi

if [[ -z "$current" ]]; then
  printf '%s\n' "$desired" | jq --indent 2 '.'
else
  printf '%s' "$current" | jq --indent 2 --argjson desired "$desired" '. * $desired'
fi
