#!/bin/bash
# motd - Display dynamic message of the day with live system stats

# Colors and formatting
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
WHITE='\033[97m'
RESET='\033[0m'

# Sanitize a value for safe inclusion in a single-quoted shell assignment
_sanitize() {
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
}

_gather_system_info() {
    local outfile="$1"
    local os_name arch hostname_str user_name

    if [[ -f /etc/os-release ]]; then
        os_name=$(source /etc/os-release && echo "$PRETTY_NAME")
    elif [[ "$(uname)" == "Darwin" ]]; then
        os_name="macOS $(sw_vers -productVersion)"
    else
        os_name=$(uname -s)
    fi

    arch=$(uname -m)
    hostname_str=$(hostname -s 2>/dev/null || hostname)
    user_name=$(whoami)

    cat > "$outfile" <<VARS
os_name='$(_sanitize "$os_name")'
arch='$(_sanitize "$arch")'
hostname_str='$(_sanitize "$hostname_str")'
user_name='$(_sanitize "$user_name")'
VARS
}

_gather_memory() {
    local outfile="$1"
    local mem_total mem_used mem_percent

    if [[ "$(uname)" == "Darwin" ]]; then
        mem_total=$(sysctl -n hw.memsize | awk '{printf "%.1f GB", $1/1024/1024/1024}')
        local pages_free pages_active pages_inactive pages_wired page_size
        pages_free=$(vm_stat | grep "Pages free" | awk '{print $3}' | tr -d '.')
        pages_active=$(vm_stat | grep "Pages active" | awk '{print $3}' | tr -d '.')
        pages_inactive=$(vm_stat | grep "Pages inactive" | awk '{print $3}' | tr -d '.')
        pages_wired=$(vm_stat | grep "Pages wired" | awk '{print $4}' | tr -d '.')
        page_size=$(sysctl -n hw.pagesize)
        local mem_used_bytes=$(( (pages_active + pages_wired) * page_size ))
        local mem_total_bytes=$(sysctl -n hw.memsize)
        mem_percent=$(awk "BEGIN {printf \"%.0f\", ($mem_used_bytes/$mem_total_bytes)*100}")
        mem_used=$(awk "BEGIN {printf \"%.1f GB\", $mem_used_bytes/1024/1024/1024}")
    else
        local mem_info=$(free -b | grep Mem)
        local mem_total_bytes=$(echo "$mem_info" | awk '{print $2}')
        local mem_used_bytes=$(echo "$mem_info" | awk '{print $3}')
        mem_total=$(awk "BEGIN {printf \"%.1f GB\", $mem_total_bytes/1024/1024/1024}")
        mem_used=$(awk "BEGIN {printf \"%.1f GB\", $mem_used_bytes/1024/1024/1024}")
        mem_percent=$(awk "BEGIN {printf \"%.0f\", ($mem_used_bytes/$mem_total_bytes)*100}")
    fi

    cat > "$outfile" <<VARS
mem_total='$(_sanitize "$mem_total")'
mem_used='$(_sanitize "$mem_used")'
mem_percent='$(_sanitize "$mem_percent")'
VARS
}

_gather_disk() {
    local outfile="$1"
    local disk_info disk_total disk_used disk_percent

    if [[ "$(uname)" == "Darwin" ]]; then
        if [[ -d "/System/Volumes/Data" ]]; then
            disk_info=$(df -H /System/Volumes/Data | tail -1)
        else
            disk_info=$(df -H / | tail -1)
        fi
    else
        disk_info=$(df -H / | tail -1)
    fi
    disk_total=$(echo "$disk_info" | awk '{print $2}')
    disk_used=$(echo "$disk_info" | awk '{print $3}')
    disk_percent=$(echo "$disk_info" | awk '{print $5}' | tr -d '%')

    cat > "$outfile" <<VARS
disk_total='$(_sanitize "$disk_total")'
disk_used='$(_sanitize "$disk_used")'
disk_percent='$(_sanitize "$disk_percent")'
VARS
}

_gather_ip() {
    local outfile="$1"
    local ip_addr

    if [[ "$(uname)" == "Darwin" ]]; then
        ip_addr=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "N/A")
    else
        ip_addr=$(hostname -I 2>/dev/null | awk '{print $1}' || ip route get 1 2>/dev/null | awk '{print $7;exit}' || echo "N/A")
    fi

    echo "ip_addr='$(_sanitize "$ip_addr")'" > "$outfile"
}

_gather_uptime() {
    local outfile="$1"
    local uptime_str

    if [[ "$(uname)" == "Darwin" ]]; then
        local boot_time now uptime_secs uptime_days uptime_hours uptime_mins
        boot_time=$(sysctl -n kern.boottime | sed 's/.*{ sec = \([0-9]*\).*/\1/')
        now=$(date +%s)
        uptime_secs=$((now - boot_time))
        uptime_days=$((uptime_secs / 86400))
        uptime_hours=$(( (uptime_secs % 86400) / 3600 ))
        uptime_mins=$(( (uptime_secs % 3600) / 60 ))
        uptime_str="${uptime_days}d ${uptime_hours}h ${uptime_mins}m"
    else
        uptime_str=$(uptime -p 2>/dev/null | sed 's/up //' || uptime | awk -F'( |,|:)+' '{print $6" days, "$8"h "$9"m"}')
    fi

    echo "uptime_str='$(_sanitize "$uptime_str")'" > "$outfile"
}

_gather_updates() {
    local outfile="$1"
    local updates_count=0
    local has_pkg_manager=false

    if command -v apt &>/dev/null; then
        has_pkg_manager=true
        updates_count=$(( updates_count + $(apt list --upgradable 2>/dev/null | grep -c upgradable || echo 0) ))
    fi
    if command -v dnf &>/dev/null; then
        has_pkg_manager=true
        updates_count=$(( updates_count + $(dnf check-update --quiet 2>/dev/null | wc -l | tr -d ' ') ))
    elif command -v yum &>/dev/null; then
        has_pkg_manager=true
        updates_count=$(( updates_count + $(yum check-update --quiet 2>/dev/null | wc -l | tr -d ' ') ))
    fi
    if command -v brew &>/dev/null; then
        has_pkg_manager=true
        updates_count=$(( updates_count + $(HOMEBREW_NO_AUTO_UPDATE=1 brew outdated 2>/dev/null | wc -l | tr -d ' ') ))
    fi

    local updates_info
    if [[ "$has_pkg_manager" == true ]]; then
        updates_info="${updates_count} packages"
    else
        updates_info="N/A"
    fi

    echo "updates_info='$(_sanitize "$updates_info")'" > "$outfile"
}

_gather_users() {
    local outfile="$1"
    local active_users users_list

    if [[ -f /.dockerenv ]] || grep -q 'docker\|lxc\|containerd' /proc/1/cgroup 2>/dev/null; then
        active_users=$(find /dev/pts -maxdepth 1 -type c ! -name ptmx 2>/dev/null | wc -l | tr -d ' ')
        users_list="docker sessions"
    else
        active_users=$(who | wc -l | tr -d ' ')
        users_list=$(who | awk '{print $1}' | sort -u | tr '\n' ' ')
    fi

    cat > "$outfile" <<VARS
active_users='$(_sanitize "$active_users")'
users_list='$(_sanitize "$users_list")'
VARS
}

_gather_chezmoi() {
    local outfile="$1"
    local chezmoi_status

    if command -v chezmoi &>/dev/null; then
        chezmoi update --apply=false &>/dev/null || true
        local chezmoi_changes
        chezmoi_changes=$(chezmoi status 2>/dev/null | wc -l | tr -d ' ')
        if [[ "$chezmoi_changes" -gt 0 ]]; then
            chezmoi_status="${YELLOW}${chezmoi_changes} files need update${RESET} (run: chezmoi apply)"
        else
            chezmoi_status="${GREEN}✓ Up to date${RESET}"
        fi
    else
        chezmoi_status="${DIM}not installed${RESET}"
    fi

    echo "chezmoi_status='$(_sanitize "$chezmoi_status")'" > "$outfile"
}

generate_motd() {
    local tmpdir
    tmpdir=$(mktemp -d)

    # Launch all data-gathering jobs in parallel
    _gather_system_info "$tmpdir/system" &
    _gather_memory "$tmpdir/memory" &
    _gather_disk "$tmpdir/disk" &
    _gather_ip "$tmpdir/ip" &
    _gather_uptime "$tmpdir/uptime" &
    _gather_updates "$tmpdir/updates" &
    _gather_users "$tmpdir/users" &
    _gather_chezmoi "$tmpdir/chezmoi" &
    wait

    # Read results into current shell
    local os_name arch hostname_str user_name
    local mem_total mem_used mem_percent
    local disk_total disk_used disk_percent
    local ip_addr uptime_str
    local updates_info active_users users_list chezmoi_status

    source "$tmpdir/system"
    source "$tmpdir/memory"
    source "$tmpdir/disk"
    source "$tmpdir/ip"
    source "$tmpdir/uptime"
    source "$tmpdir/updates"
    source "$tmpdir/users"
    source "$tmpdir/chezmoi"

    rm -rf "$tmpdir"

    # Build progress bar function
    progress_bar() {
        local percent=$1
        local width=20
        local filled=$((percent * width / 100))
        local empty=$((width - filled))
        local bar=""

        for ((i=0; i<filled; i++)); do bar+="█"; done
        for ((i=0; i<empty; i++)); do bar+="░"; done

        if [[ $percent -ge 90 ]]; then
            echo -e "${YELLOW}${bar}${RESET}"
        elif [[ $percent -ge 70 ]]; then
            echo -e "${CYAN}${bar}${RESET}"
        else
            echo -e "${GREEN}${bar}${RESET}"
        fi
    }

    # Fixed 68-character width box with centered text
    local box_width=68
    local max_text_len=$((box_width - 4))  # Account for ║ and spaces on each side
    local welcome_text="Welcome to ${hostname_str}"
    if [[ ${#welcome_text} -gt $max_text_len ]]; then
        welcome_text="${welcome_text:0:$((max_text_len - 3))}..."
    fi
    local text_len=${#welcome_text}
    local total_padding=$((box_width - 2 - text_len))  # -2 for the ║ on each side
    local left_pad=$((total_padding / 2))
    local right_pad=$((total_padding - left_pad))
    local left_spaces=$(printf '%*s' $left_pad '')
    local right_spaces=$(printf '%*s' $right_pad '')
    local border=""
    for ((i=0; i<box_width-2; i++)); do border+="═"; done

    # Generate the MOTD
    cat << EOF

${CYAN}╔${border}╗${RESET}
${CYAN}║${RESET}${left_spaces}${BOLD}${WHITE}${welcome_text}${RESET}${right_spaces}${CYAN}║${RESET}
${CYAN}╚${border}╝${RESET}

  ${BOLD}${BLUE}SYSTEM${RESET}
  ├─ ${DIM}OS${RESET}           ${os_name}
  ├─ ${DIM}User${RESET}         ${user_name}
  ├─ ${DIM}Arch${RESET}         ${arch}
  └─ ${DIM}Uptime${RESET}       ${uptime_str}

  ${BOLD}${MAGENTA}RESOURCES${RESET}
  ├─ ${DIM}Memory${RESET}       ${mem_used} / ${mem_total} (${mem_percent}%)
  │              $(progress_bar ${mem_percent})
  ├─ ${DIM}Disk${RESET}         ${disk_used} / ${disk_total} (${disk_percent}%)
  │              $(progress_bar ${disk_percent})
  └─ ${DIM}IP Address${RESET}   ${ip_addr}

  ${BOLD}${GREEN}STATUS${RESET}
  ├─ ${DIM}Updates${RESET}      ${updates_info} available
  ├─ ${DIM}Chezmoi${RESET}      ${chezmoi_status}
  └─ ${DIM}Sessions${RESET}     ${active_users} active (${users_list})

${DIM}────────────────────────────────────────────────────────────────────────${RESET}
EOF
}

echo -e "$(generate_motd)"
