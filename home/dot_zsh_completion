# ~/.zsh_completion - custom zsh completions

# --- Git ---
if command -v git &>/dev/null; then
    # Zsh ships with git completions; ensure aliases get completion
    compdef g=git
    compdef gs=git
    compdef ga=git
    compdef gaa=git
    compdef gam=git
    compdef gc=git
    compdef gca=git
    compdef gch=git
    compdef gb=git
    compdef gr=git
    compdef grc=git
    compdef gra=git
fi

# --- Docker ---
if command -v docker &>/dev/null; then
    if [[ -f /usr/share/zsh/vendor-completions/_docker ]]; then
        source /usr/share/zsh/vendor-completions/_docker
    elif [[ -f /opt/homebrew/share/zsh/site-functions/_docker ]]; then
        source /opt/homebrew/share/zsh/site-functions/_docker
    fi
fi

# --- Kubernetes ---
if command -v kubectl &>/dev/null; then
    source <(kubectl completion zsh)
    compdef k=kubectl
fi

if command -v kubens &>/dev/null; then
    # Note the leading underscore: kubectx's release tarball names its zsh
    # completion functions _kubens.zsh / _kubectx.zsh (standard zsh function
    # naming), unlike the unprefixed kubens.bash / kubectx.bash for bash.
    if [[ -f "$HOME/.local/kubectx/completion/_kubens.zsh" ]]; then
        source "$HOME/.local/kubectx/completion/_kubens.zsh"
    elif [[ -f /usr/share/zsh/vendor-completions/_kubens ]]; then
        source /usr/share/zsh/vendor-completions/_kubens
    fi
    # Apply to alias
    compdef _kube_namespaces kn 2>/dev/null || true
fi

if command -v kubectx &>/dev/null; then
    if [[ -f "$HOME/.local/kubectx/completion/_kubectx.zsh" ]]; then
        source "$HOME/.local/kubectx/completion/_kubectx.zsh"
    elif [[ -f /usr/share/zsh/vendor-completions/_kubectx ]]; then
        source /usr/share/zsh/vendor-completions/_kubectx
    fi
    # Apply to alias
    compdef _kube_contexts kx 2>/dev/null || true
fi

# --- kind ---
if command -v kind &>/dev/null; then
    source <(kind completion zsh)
fi

# --- gh (GitHub CLI) ---
if command -v gh &>/dev/null; then
    source <(gh completion -s zsh)
fi

# --- chezmoi ---
if command -v chezmoi &>/dev/null; then
    source <(chezmoi completion zsh)
fi

# --- NVM ---
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
