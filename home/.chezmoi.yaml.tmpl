# chezmoi configuration file (YAML format)
# This template prompts for user-specific values during `chezmoi init`

{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}
{{- /*                              User Info                                  */ -}}
{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}

{{- $name := promptStringOnce . "name" "Full name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $githubUsername := promptStringOnce . "githubUsername" "GitHub username" -}}
{{- $sshSigningKey := promptStringOnce . "sshSigningKey" "SSH signing key path" "~/.ssh/id_github.pub" -}}

{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}
{{- /*                                 SSH                                     */ -}}
{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}

{{- $generateSshKey := promptBoolOnce . "generateSshKey" "Generate an ed25519 SSH key for GitHub" false -}}
{{- $sshKeyName := "" -}}
{{- if $generateSshKey -}}
{{-   $sshKeyName = promptStringOnce . "sshKeyName" "SSH key filename" "id_github" -}}
{{- end -}}

{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}
{{- /*                              Packages                                   */ -}}
{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}

{{- $installDevtools := promptBoolOnce . "packages.devtools" "Development tools" true -}}
{{- $installNeovim := promptBoolOnce . "packages.neovim" "Neovim" true -}}
{{- $installDocker := promptBoolOnce . "packages.docker" "Docker" false -}}
{{- $installGo := promptBoolOnce . "packages.go" "Go" true -}}
{{- $installKubernetes := promptBoolOnce . "packages.kubernetes" "Kubernetes tools" true -}}
{{- $installLima := promptBoolOnce . "packages.lima" "Lima VMs" false -}}
{{- $installNode := promptBoolOnce . "packages.node" "Node" true -}}
{{- $installPython := promptBoolOnce . "packages.python" "Python" true -}}

{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}
{{- /*                              Add-ons                                    */ -}}
{{- /* ═══════════════════════════════════════════════════════════════════════ */ -}}

{{- $installFonts := promptBoolOnce . "addons.fonts" "Fonts" false }}
{{- $installMotd := promptBoolOnce . "addons.motd" "Custom MOTD" true }}
{{- $installAI := promptBoolOnce . "addons.ai" "AI Config" true }}
{{- $claudeProvider := "" }}
{{- if $installAI }}
{{-   $claudeProvider = promptStringOnce . "addons.claudeProvider" "Claude provider (claude/bedrock)" "claude" }}
{{- end }}
{{- $installVscode := promptBoolOnce . "addons.vscode" "VSCode Config" true }}
{{- $installObsidian := promptBoolOnce . "addons.obsidian" "Obsidian vaults at ~/vaults (personal, libdex)" false }}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  githubUsername: {{ $githubUsername | quote }}
  sshSigningKey: {{ $sshSigningKey | quote }}
  generateSshKey: {{ $generateSshKey }}
  sshKeyName: {{ $sshKeyName | quote }}
  packages:
    devtools: {{ $installDevtools }}
    neovim: {{ $installNeovim }}
    docker: {{ $installDocker }}
    go: {{ $installGo }}
    kubernetes: {{ $installKubernetes }}
    lima: {{ $installLima }}
    node: {{ $installNode }}
    python: {{ $installPython }}
  addons:
    fonts: {{ $installFonts }}
    motd: {{ $installMotd }}
    ai: {{ $installAI }}
    claudeProvider: {{ $claudeProvider | quote }}
    vscode: {{ $installVscode }}
    obsidian: {{ $installObsidian }}
