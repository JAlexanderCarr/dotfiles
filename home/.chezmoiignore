# chezmoi ignore file
# Files and patterns listed here will not be managed by chezmoi

# README and documentation
README.md
LICENSE

# Build directory (for container testing)
build/

# Font files are installed via run_once script, not directly by chezmoi
# This prevents chezmoi from trying to manage them in the system font directory
fonts/

# VSCode config files are installed directly by the install script
vscode/

# Editor and IDE files
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Git
.git/
.gitignore

# Temporary files
*.tmp
*.temp
*.bak

# AI agent configs (conditional)
{{ if not .addons.ai }}
.claude/
.codex/
.config/aide/AI_PREFERENCES.md
.config/aide/ai-templates/
.local/bin/aide
{{ end }}

# MOTD (conditional)
{{ if not .addons.motd }}
.local/bin/motd
.local/bin/motd-static
{{ end }}

# Lima VM templates (conditional)
{{ if not .packages.lima }}
.config/lima/
{{ end }}
