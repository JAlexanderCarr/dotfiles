# chezmoi ignore file
# Files and patterns listed here will not be managed by chezmoi

# README and documentation
README.md
LICENSE

# Build directory (for container testing)
build/

# Font files are installed via run_once script, not directly by chezmoi
# This prevents chezmoi from trying to manage them in the system font directory
fonts/

# VSCode config files are installed directly by the install script
vscode/

# Obsidian vaults at ~/vaults/ (personal, libdex, agent-db) — excluded when addon is off
{{ if not .addons.obsidian }}
vaults/
{{ end }}

# Editor and IDE files
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Git
.git/
.gitignore

# Temporary files
*.tmp
*.temp
*.bak

# Claude Code config (conditional)
{{ if not .addons.ai }}
.claude/
.config/ccstatusline/
{{ end }}

# MOTD (conditional)
{{ if not .addons.motd }}
.local/bin/motd
.local/bin/motd-static
{{ end }}

# Lima VM templates (conditional)
{{ if not .packages.lima }}
.config/lima/
{{ end }}

# npm config (conditional)
{{ if not .packages.node }}
.npmrc
{{ end }}

# nvim symlink onto ~/.local/bin (conditional) — binary comes from
# .chezmoiexternal.yaml.tmpl, only relevant when neovim is enabled
{{ if not .packages.neovim }}
.local/bin/nvim
{{ end }}

# kubectx/kubens symlinks onto ~/.local/bin (conditional) — binaries come
# from .chezmoiexternal.yaml.tmpl, only relevant when kubernetes is enabled
{{ if not .packages.kubernetes }}
.local/bin/kubectx
.local/bin/kubens
{{ end }}

# limactl symlink onto ~/.local/bin (conditional) — only relevant on Linux,
# where the binary comes from .chezmoiexternal.yaml.tmpl; macOS installs
# limactl via Homebrew instead (run_onchange_install-lima.sh.tmpl)
{{ if not (and .packages.lima (eq .chezmoi.os "linux")) }}
.local/bin/limactl
{{ end }}
