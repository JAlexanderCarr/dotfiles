# ~/.bash_profile - executed by bash(1) for login shells

# Source .profile to ensure consistent environment setup
if [ -f "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi

# Source .bashrc for interactive login shells (aliases, completions, tool inits)
if [ -n "$PS1" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
