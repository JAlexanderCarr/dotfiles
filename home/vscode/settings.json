{
    // Editor specific config
    "workbench.startupEditor": "none",
    "editor.fontFamily": "'FiraMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
    "editor.rulers": [80],
    "workbench.editor.enablePreview": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.osx": {
        "tmux": {
            "path": "tmux",
            "args": ["new-session", "-c", "${workspaceFolder}"],
            "icon": "terminal-tmux"
        },
        "zsh": { "path": "zsh", "args": ["-l"] },
        "bash": { "path": "bash", "args": ["-l"] }
    },
    "terminal.integrated.profiles.linux": {
        "tmux": {
            "path": "tmux",
            "args": ["new-session", "-c", "${workspaceFolder}"],
            "icon": "terminal-tmux"
        },
        "zsh": { "path": "zsh", "args": ["-l"] },
        "bash": { "path": "bash", "args": ["-l"] }
    },
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "docker-desktop"
    ],
    "chat.disableAIFeatures": true,
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.editorActionsLocation": "titleBar",

    // Visuals
    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.iconTheme": "material-icon-theme",

    // Extensions - Go
    "go.toolsManagement.autoUpdate": true,

    // Terminal suggestions
    "terminal.integrated.suggest.quickSuggestions": {
        "commands": "on",
        "arguments": "on",
        "unknown": "off"
    },
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "terminal.integrated.suggest.insertTrailingSpace": true,

    // Extensions - Claude
    "claudeCode.preferredLocation": "panel"
}
